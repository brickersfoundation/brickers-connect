{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brickers-connect",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brickers-connect-db",
      "database_id": "6d3dfda1-0c1d-49a8-90d9-e8c7f2e67211"
    }
  ]
}
